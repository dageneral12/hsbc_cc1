<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_RpaHarness" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="HSBC_RPA_Test_Harness" name="HSBC RPA Test Harness" isExecutable="true">
    <bpmn:documentation>Test-only process. Start variable target = "dqm", "mivision" or "echamps" selects the RPA task; the task input variables are passed straight from the start variables (no AI). Outputs: dqmResult / mivisionResult / echampsResult. Driven by tests/rpa/run_rpa_tests.py. Not part of the demo.</bpmn:documentation>
    <bpmn:startEvent id="Start_Harness" name="Test case requested">
      <bpmn:outgoing>F_Start_Gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_Target" name="target?" default="F_Gw_Unknown">
      <bpmn:incoming>F_Start_Gw</bpmn:incoming>
      <bpmn:outgoing>F_Gw_dqm</bpmn:outgoing>
      <bpmn:outgoing>F_Gw_mivision</bpmn:outgoing>
      <bpmn:outgoing>F_Gw_echamps</bpmn:outgoing>
      <bpmn:outgoing>F_Gw_Unknown</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Dqm" name="DQM customer lookup (RPA)" zeebe:modelerTemplate="camunda.connectors.rpa" zeebe:modelerTemplateVersion="2" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="={&#10;  label: if (camundaRpaWorkerLabel = null or camundaRpaWorkerLabel = &#34;&#34;) then &#34;default&#34; else camundaRpaWorkerLabel,&#10;  baseName: &#34;camunda::RPA-Task::&#34;,&#10;  definitionType: baseName + label&#10;}.definitionType" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="default" target="camundaRpaWorkerLabel" />
            <zeebe:input source="=get or else(senderEmail, &#34;&#34;)" target="senderEmail" />
            <zeebe:input source="=get or else(companyName, &#34;&#34;)" target="companyName" />
            <zeebe:input source="=get or else(caseNumber, &#34;&#34;)" target="caseNumber" />
            <zeebe:input source="=get or else(simulatorScenario, &#34;&#34;)" target="simulatorScenario" />
          <zeebe:output source="=dqmResult" target="dqmResult" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="camunda::timeout" value="PT5M" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
        <zeebe:properties>
          <zeebe:property name="camunda::enablePreRun" value="false" />
          <zeebe:property name="camunda::postRun" value="false" />
        </zeebe:properties>
        <zeebe:linkedResources>
          <zeebe:linkedResource resourceId="RPA_1sctslp" resourceType="RPA" linkName="RPAScript" />
        </zeebe:linkedResources>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Gw_dqm</bpmn:incoming>
      <bpmn:outgoing>F_Task_Dqm_out</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_MiVision" name="MiVision client and card lookup (RPA)" zeebe:modelerTemplate="camunda.connectors.rpa" zeebe:modelerTemplateVersion="2" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="={&#10;  label: if (camundaRpaWorkerLabel = null or camundaRpaWorkerLabel = &#34;&#34;) then &#34;default&#34; else camundaRpaWorkerLabel,&#10;  baseName: &#34;camunda::RPA-Task::&#34;,&#10;  definitionType: baseName + label&#10;}.definitionType" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="default" target="camundaRpaWorkerLabel" />
            <zeebe:input source="=get or else(customerNumber, &#34;&#34;)" target="customerNumber" />
            <zeebe:input source="=get or else(clientName, &#34;&#34;)" target="clientName" />
            <zeebe:input source="=get or else(clientId, &#34;&#34;)" target="clientId" />
            <zeebe:input source="=get or else(cardFirstEight, &#34;&#34;)" target="cardFirstEight" />
            <zeebe:input source="=get or else(cardLastFour, &#34;&#34;)" target="cardLastFour" />
            <zeebe:input source="=get or else(simulatorScenario, &#34;&#34;)" target="simulatorScenario" />
          <zeebe:output source="=mivisionResult" target="mivisionResult" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="camunda::timeout" value="PT5M" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
        <zeebe:properties>
          <zeebe:property name="camunda::enablePreRun" value="false" />
          <zeebe:property name="camunda::postRun" value="false" />
        </zeebe:properties>
        <zeebe:linkedResources>
          <zeebe:linkedResource resourceId="RPA_09aoltb" resourceType="RPA" linkName="RPAScript" />
        </zeebe:linkedResources>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Gw_mivision</bpmn:incoming>
      <bpmn:outgoing>F_Task_MiVision_out</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_EChamps" name="eChamps decline investigation (RPA)" zeebe:modelerTemplate="camunda.connectors.rpa" zeebe:modelerTemplateVersion="2" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="={&#10;  label: if (camundaRpaWorkerLabel = null or camundaRpaWorkerLabel = &#34;&#34;) then &#34;default&#34; else camundaRpaWorkerLabel,&#10;  baseName: &#34;camunda::RPA-Task::&#34;,&#10;  definitionType: baseName + label&#10;}.definitionType" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="default" target="camundaRpaWorkerLabel" />
            <zeebe:input source="=get or else(accountNumber, &#34;&#34;)" target="accountNumber" />
            <zeebe:input source="=get or else(cardLastFour, &#34;&#34;)" target="cardLastFour" />
            <zeebe:input source="=get or else(transactionDate, &#34;&#34;)" target="transactionDate" />
            <zeebe:input source="=get or else(transactionAmount, &#34;&#34;)" target="transactionAmount" />
            <zeebe:input source="=get or else(simulatorScenario, &#34;&#34;)" target="simulatorScenario" />
          <zeebe:output source="=echampsResult" target="echampsResult" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="camunda::timeout" value="PT5M" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
        <zeebe:properties>
          <zeebe:property name="camunda::enablePreRun" value="false" />
          <zeebe:property name="camunda::postRun" value="false" />
        </zeebe:properties>
        <zeebe:linkedResources>
          <zeebe:linkedResource resourceId="RPA_0daw5hw" resourceType="RPA" linkName="RPAScript" />
        </zeebe:linkedResources>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Gw_echamps</bpmn:incoming>
      <bpmn:outgoing>F_Task_EChamps_out</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Join">
      <bpmn:incoming>F_Task_Dqm_out</bpmn:incoming>
      <bpmn:incoming>F_Task_MiVision_out</bpmn:incoming>
      <bpmn:incoming>F_Task_EChamps_out</bpmn:incoming>
      <bpmn:outgoing>F_Join_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Harness" name="Test case done">
      <bpmn:incoming>F_Join_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_UnknownTarget" name="Unknown target">
      <bpmn:incoming>F_Gw_Unknown</bpmn:incoming>
      <bpmn:errorEventDefinition id="Err_UnknownTarget_Def" errorRef="Err_UnknownTarget" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_Start_Gw" sourceRef="Start_Harness" targetRef="Gw_Target" />
    <bpmn:sequenceFlow id="F_Gw_dqm" name="dqm" sourceRef="Gw_Target" targetRef="Task_Dqm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=target = "dqm"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Task_Dqm_out" sourceRef="Task_Dqm" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F_Gw_mivision" name="mivision" sourceRef="Gw_Target" targetRef="Task_MiVision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=target = "mivision"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Task_MiVision_out" sourceRef="Task_MiVision" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F_Gw_echamps" name="echamps" sourceRef="Gw_Target" targetRef="Task_EChamps">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=target = "echamps"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Task_EChamps_out" sourceRef="Task_EChamps" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="F_Gw_Unknown" name="other" sourceRef="Gw_Target" targetRef="End_UnknownTarget" />
    <bpmn:sequenceFlow id="F_Join_End" sourceRef="Gw_Join" targetRef="End_Harness" />
  </bpmn:process>
  <bpmn:error id="Err_UnknownTarget" name="Unknown target" errorCode="UNKNOWN_TARGET" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="HSBC_RPA_Test_Harness">
      <bpmndi:BPMNShape id="S_Start" bpmnElement="Start_Harness"><dc:Bounds x="162" y="212" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Gw" bpmnElement="Gw_Target" isMarkerVisible="true"><dc:Bounds x="255" y="205" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Dqm" bpmnElement="Task_Dqm"><dc:Bounds x="380" y="40" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_MiVision" bpmnElement="Task_MiVision"><dc:Bounds x="380" y="150" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_EChamps" bpmnElement="Task_EChamps"><dc:Bounds x="380" y="260" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_EndU" bpmnElement="End_UnknownTarget"><dc:Bounds x="412" y="372" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Join" bpmnElement="Gw_Join" isMarkerVisible="true"><dc:Bounds x="545" y="205" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End" bpmnElement="End_Harness"><dc:Bounds x="652" y="212" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E1" bpmnElement="F_Start_Gw"><di:waypoint x="198" y="230" /><di:waypoint x="255" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_in_dqm" bpmnElement="F_Gw_dqm"><di:waypoint x="280" y="205" /><di:waypoint x="280" y="80" /><di:waypoint x="380" y="80" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_out_Task_Dqm" bpmnElement="F_Task_Dqm_out"><di:waypoint x="480" y="80" /><di:waypoint x="570" y="80" /><di:waypoint x="570" y="205" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_in_mivision" bpmnElement="F_Gw_mivision"><di:waypoint x="280" y="205" /><di:waypoint x="280" y="190" /><di:waypoint x="380" y="190" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_out_Task_MiVision" bpmnElement="F_Task_MiVision_out"><di:waypoint x="480" y="190" /><di:waypoint x="570" y="190" /><di:waypoint x="570" y="205" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_in_echamps" bpmnElement="F_Gw_echamps"><di:waypoint x="280" y="205" /><di:waypoint x="280" y="300" /><di:waypoint x="380" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_out_Task_EChamps" bpmnElement="F_Task_EChamps_out"><di:waypoint x="480" y="300" /><di:waypoint x="570" y="300" /><di:waypoint x="570" y="205" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E4" bpmnElement="F_Gw_Unknown"><di:waypoint x="280" y="255" /><di:waypoint x="280" y="390" /><di:waypoint x="412" y="390" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E7" bpmnElement="F_Join_End"><di:waypoint x="595" y="230" /><di:waypoint x="652" y="230" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
